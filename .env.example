# Optional backend credentials. Leave blank for the default Mock-only experience.
# Copy this file to .env locally. Never add VITE_ to a secret's variable name.
# Do not paste keys into source files, screenshots, issue reports, or project JSON.
OPENWEATHER_API_KEY=

# Local-safe defaults. Expose a service only behind HTTPS and suitable edge limits.
HOST=127.0.0.1
PORT=8787
